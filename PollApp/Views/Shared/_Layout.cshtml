@* Views/Shared/_Layout.cshtml (полный файл: шапка 70px, белый фон, тень; бургер зелёный слева, логотип зелёный, поиск центр светло-серый с зелёной иконкой, справа иконки + аватар с модалом; меню слева как Google Workspace; белый/зелёный стиль) *@
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PollApp</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="header-container">
            <!-- Левая часть: бургер + логотип -->
            <button class="burger-menu" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
            <a class="logo" asp-controller="Poll" asp-action="Index">
                <span>Полес.Формы</span>  <!-- Зеленый логотип -->
            </a>

            <!-- Центр: поиск -->
            <form class="search-bar">
                <input type="search" placeholder="Поиск..." />
                <i class="fas fa-search search-icon"></i>
            </form>

            <!-- Правая часть: иконки + аватар -->
            <div class="header-right">
                <i class="fas fa-th header-icon"></i>  <!-- Галерея -->
                <i class="fas fa-question-circle header-icon"></i>  <!-- Помощь -->
                <i class="fas fa-cog header-icon"></i>  <!-- Настройки -->
                <img src="/images/avatar.png" class="avatar" alt="Avatar" onclick="toggleProfileModal()" />
            </div>
        </div>
    </header>

    <!-- Меню слева (как Google Workspace) -->
    <div class="sidebar" id="sidebar">
        <button class="close-btn" onclick="toggleSidebar()"><i class="fas fa-times"></i></button>
        <ul>
            <li><i class="fas fa-poll"></i> Формы</li>
            <li><i class="fas fa-file-alt"></i> Документы</li>
            <li><i class="fas fa-table"></i> Таблицы</li>
            <li><i class="fas fa-file-powerpoint"></i> Презентации</li>
            <li><i class="fas fa-cloud"></i> Диск</li>
            <li><i class="fas fa-cog"></i> Настройки</li>
            <li><i class="fas fa-question-circle"></i> Справка/отзывы</li>
        </ul>
    </div>

    <!-- Всплывающее меню профиля (белая карточка, тень, скругления 12px) -->
    <div class="profile-modal" id="profileModal">
        <div class="profile-content">
            <img src="/images/avatar-large.png" class="profile-avatar" alt="Avatar">
            <h3>Имя Пользователя</h3>
            <p>email@example.com</p>
            <button class="profile-btn">Выйти</button>
        </div>
    </div>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>