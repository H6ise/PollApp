@model PollApp.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="account-container">
    <div class="account-card">
        <h1>Регистрация</h1>

        <form asp-action="Register" method="post">
            @* Сводка всех ошибок валидации (включая ошибки Identity) *@
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group submit-group">
                <button type="submit" class="custom-btn primary-btn full-width-btn">Зарегистрироваться</button>
            </div>
        </form>

        <p class="account-link-footer">
            Уже есть аккаунт? <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">Войти</a>
        </p>
    </div>
</div>

@section Scripts {
@* Обязательно для клиентской валидации *@
    <partial name="_ValidationScriptsPartial" />
}