@* Views/Admin/Create.cshtml (конструктор опроса в стиле Google Forms: зелёный хедер, табы, блок вопроса, сайдбар справа) *@
@model PollApp.ViewModels.PollViewModel

@{
    ViewData["Title"] = "Новая форма";
}

<div class="constructor-container">
    <!-- Табы сверху -->
    <div class="tabs">
        <button class="tab active">Вопросы</button>
        <button class="tab">Ответы</button>
        <button class="tab">Настройки</button>
    </div>

    <!-- Основная область формы -->
    <div class="form-editor">
        <!-- Хедер формы (зелёный вместо фиолетового) -->
        <div class="form-header" style="background-color: #e8f5e9; border-top: 4px solid #4caf50; padding: 24px; border-radius: 8px 8px 0 0;">
            <input type="text" class="form-title" value="Новая форма" style="font-size: 24px; font-weight: 500; border: none; background: transparent; width: 100%;" />
            <input type="text" class="form-description" value="Описание" style="font-size: 14px; border: none; background: transparent; width: 100%; color: #5f6368;" />
        </div>

        <!-- Блок вопроса -->
        <div class="question-block shadow-sm" style="background-color: #fff; border: 1px solid #dadce0; border-radius: 8px; padding: 24px; margin: 24px 0;">
            <div class="question-row" style="display: flex; align-items: center; margin-bottom: 16px;">
                <input type="text" class="question-title" value="Вопрос без заголовка" style="flex: 1; font-size: 16px; border-bottom: 1px solid #dadce0; border-top: none; border-left: none; border-right: none; padding: 8px 0;" />
                <select class="question-type" style="margin-left: 16px; padding: 8px; border: 1px solid #dadce0; border-radius: 4px;">
                    <option>Один из списка</option>
                    <option>Несколько из списка</option>
                    <option>Текстовый ответ</option>
                </select>
            </div>

            <!-- Варианты ответов (для radio/checkbox) -->
            <div class="options-list" id="optionsList">
                <div class="option-item" style="display: flex; align-items: center; margin-bottom: 12px;">
                    <input type="radio" disabled style="margin-right: 8px;" />
                    <input type="text" value="Вариант 1" style="flex: 1; border: none; border-bottom: 1px dotted #dadce0; padding: 4px 0;" />
                    <i class="fas fa-image option-icon" style="margin-left: 8px; color: #5f6368; cursor: pointer;"></i>
                    <i class="fas fa-trash option-icon" style="margin-left: 8px; color: #5f6368; cursor: pointer;" onclick="removeOption(this)"></i>
                </div>
                <!-- Добавьте больше вариантов динамически -->
            </div>

            <button class="add-option" onclick="addOption()" style="background: none; border: none; color: #1a73e8; cursor: pointer; margin-top: 8px;">Добавить вариант или "Другой"</button>

            <!-- Для текстового типа (hidden по умолчанию) -->
            <div class="text-input-preview" style="display: none; border: 1px solid #dadce0; border-radius: 4px; padding: 12px; margin-top: 16px;">
                Короткий ответ
            </div>
        </div>
    </div>

    <!-- Сайдбар справа -->
    <div class="sidebar-right">
        <i class="fas fa-plus sidebar-icon" title="Добавить вопрос"></i>
        <i class="fas fa-copy sidebar-icon" title="Дублировать"></i>
        <i class="fas fa-image sidebar-icon" title="Добавить изображение"></i>
        <i class="fas fa-video sidebar-icon" title="Добавить видео"></i>
        <i class="fas fa-section sidebar-icon" title="Добавить раздел"></i>  <!-- Кастом иконка для секции -->
        <i class="fas fa-trash sidebar-icon" title="Удалить"></i>
    </div>
</div>

@section Scripts {
    <script>
        function addOption() {
            const option = document.createElement('div');
            option.className = 'option-item';
            option.style = 'display: flex; align-items: center; margin-bottom: 12px;';
            option.innerHTML = `
                <input type="radio" disabled style="margin-right: 8px;" />
                <input type="text" value="Вариант" style="flex: 1; border: none; border-bottom: 1px dotted #dadce0; padding: 4px 0;" />
                <i class="fas fa-image option-icon" style="margin-left: 8px; color: #5f6368; cursor: pointer;"></i>
                <i class="fas fa-trash option-icon" style="margin-left: 8px; color: #5f6368; cursor: pointer;" onclick="removeOption(this)"></i>
            `;
            document.getElementById('optionsList').appendChild(option);
        }

        function removeOption(element) {
            element.parentElement.remove();
        }

        // Переключение типа вопроса
        document.querySelector('.question-type').addEventListener('change', function () {
            const type = this.value;
            const options = document.getElementById('optionsList');
            const textPreview = document.querySelector('.text-input-preview');
            if (type === 'Текстовый ответ') {
                options.style.display = 'none';
                textPreview.style.display = 'block';
            } else {
                options.style.display = 'block';
                textPreview.style.display = 'none';
                options.querySelectorAll('input[type="radio"]').forEach(input => input.type = type === 'Несколько из списка' ? 'checkbox' : 'radio');
            }
        });
    </script>
}