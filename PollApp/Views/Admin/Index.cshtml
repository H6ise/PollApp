@model List<PollApp.Models.Poll>

@{
    ViewData["Title"] = "Admin Panel - Polls";
}

<h1>Admin Panel - Polls</h1>

<div class="admin-actions">
    <a asp-action="Create" class="custom-btn primary-btn mb-3">Create New Poll</a>
    <a asp-action="Users" class="custom-btn secondary-btn mb-3">Manage Users</a>
</div>

<table class="data-table striped-table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var poll in Model)
        {
            <tr>
                <td data-label="Title">@poll.Title</td>
                <td data-label="Description">@poll.Description</td>
                <td data-label="Start Date">@poll.StartDate.ToShortDateString()</td>
                <td data-label="End Date">@(poll.EndDate?.ToShortDateString() ?? "N/A")</td>
                <td data-label="Active">@(poll.IsActive ? "Yes" : "No")</td>
                <td data-label="Actions" class="action-links">
                    <a asp-action="Edit" asp-route-id="@poll.Id" class="custom-btn warning-btn sm-btn">Edit</a>
                    <form asp-action="Delete" asp-route-id="@poll.Id" method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="custom-btn danger-btn sm-btn" onclick="return confirm('Are you sure you want to delete this poll?');">Delete</button>
                    </form>
                    <a asp-controller="Poll" asp-action="Results" asp-route-id="@poll.Id" class="custom-btn info-btn sm-btn">Results</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Pagination" class="pagination-nav">
    <ul class="pagination-list">
        <li class="page-item @(ViewBag.Page > 1 ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page - 1)">Previous</a>
        </li>
        <li class="page-item @(ViewBag.HasNext ? "" : "disabled")">
            <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.Page + 1)">Next</a>
        </li>
    </ul>
</nav>