@* Views/Poll/Index.cshtml *@
@model List<PollApp.Models.Poll>

@{
    ViewData["Title"] = "Формы";
}

<div class="container-fluid px-3 py-4">
    <!-- Раздел "Создать форму" с улучшенным дизайном (добавлены AI-шаблоны как в 2025 трендах) -->
    <h6 class="text-muted mb-3 fw-medium">Создать форму</h6>
    <div class="row g-3 mb-5">
        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
            <a asp-controller="Admin" asp-action="Create" class="text-decoration-none">
                <div class="card border-0 shadow hover-shadow" style="border-radius: 12px; height: 180px; overflow: hidden;">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <div class="plus-icon mb-2"></div>  <!-- Цветной плюс -->
                        <small class="text-dark">Пустая форма</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
            <div class="card border-0 shadow hover-shadow" style="border-radius: 12px; height: 180px; background-color: #e8f5e9;">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <i class="fas fa-address-book fa-2x text-green mb-2"></i>
                    <small class="text-dark">Контактная информация</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
            <div class="card border-0 shadow hover-shadow" style="border-radius: 12px; height: 180px; background-color: #fff3e0;">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <i class="fas fa-robot fa-2x text-orange mb-2"></i>  <!-- AI-шаблон, тренд 2025 -->
                    <small class="text-dark">AI-опрос (новинка)</small>
                </div>
            </div>
        </div>
        <!-- Добавьте больше шаблонов для полноты -->
    </div>

    <!-- Раздел "Недавние формы" с поиском и улучшенным grid -->
    <h6 class="text-muted mb-3 fw-medium">Недавние формы</h6>
    <div class="row g-3">
        @foreach (var poll in Model)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                <div class="card border-0 shadow hover-shadow" style="border-radius: 12px; height: 180px; overflow: hidden;">
                    <div class="card-header bg-purple text-white py-1 text-center" style="background-color: #673ab7; font-size: 0.8rem;">
                        @poll.Title
                    </div>
                    <div class="card-body d-flex align-items-center justify-content-center bg-light">
                        <i class="fas fa-file-alt fa-2x text-muted"></i>
                    </div>
                    <div class="card-footer bg-transparent border-0 text-center small text-muted">
                        @poll.StartDate.ToString("d MMM yyyy")
                    </div>
                </div>
            </div>
        }
    </div>
</div>