@* Views/Poll/Index.cshtml *@
@model List<PollApp.Models.Poll>

@{
    ViewData["Title"] = "Опросы";
}

<h2>Список опросов</h2>
<ul>
@foreach (var poll in Model)
{
    <li>
        <a href="@Url.Action("Details", "Poll", new { id = poll.Id })">@poll.Title</a>
        <span>— @poll.Description</span>
    </li>
}
</ul>
@if (ViewBag.HasNext == true)
{
    <a href="@Url.Action("Index", new { page = (int)ViewBag.Page + 1 })">Следующая страница</a>
}
