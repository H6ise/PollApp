@* Views/Poll/Index.cshtml (стартовая: карточки с шапкой/картинкой, loader, шаблоны, поиск по названиям, кнопка вида отображения) *@
@model List<PollApp.Models.Poll>

@{
    ViewData["Title"] = "Формы";
    var templates = new List<(string Title, string Description)> { ("Пустая форма", "Начните с нуля"), ("Анкета", "Соберите данные") };
      <!-- Шаблоны -->
}

<div class="main-content">
    <h2>Создать форму</h2>
    <div class="card-grid" id="templateGrid">
        @foreach (var template in templates)
        {
            <div class="card loader-fade">
                <div class="card-header">@template.Title</div>
                <img src="/images/template-preview.png" alt="Preview" class="card-img">
                <div class="card-body">@template.Description</div>
            </div>
        }
    </div>

    <h2>Недавние формы</h2>
    <button onclick="toggleView()" class="view-toggle">Переключить вид (grid/list)</button>
    <div class="card-grid" id="pollGrid">
        @foreach (var poll in Model)
        {
            <a asp-action="Details" asp-route-id="@poll.Id" class="text-decoration-none">
                <div class="card loader-fade">
                    <div class="card-header">@poll.Title</div>
                    <img src="@poll.HeaderImageUrl" alt="Header" class="card-img">  <!-- Шапка картинка -->
                    <div class="card-body">@poll.Description</div>
                    <div class="card-footer">@poll.StartDate.ToShortDateString() - @(poll.IsActive ? "Активен" : "Завершён")</div>
                </div>
            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        function searchPolls(value) {
            const cards = document.querySelectorAll('#pollGrid .card');
            cards.forEach(card => {
                card.style.display = card.textContent.toLowerCase().includes(value.toLowerCase()) ? 'block' : 'none';
            });
        }

        function toggleView() {
            document.getElementById('pollGrid').classList.toggle('list-view');
        }

        // Loader: gradual fade-in
        window.onload = function () {
            const items = document.querySelectorAll('.loader-fade');
            items.forEach((item, index) => {
                setTimeout(() => item.style.opacity = 1, index * 200);
            });
        };
    </script>
}