@model PollApp.Models.Poll

@{
    ViewData["Title"] = Model.Id == 0 ? "Новая форма" : "Редактирование формы";
}

<div class="form-builder-page">
    <div class="form-builder-header">
        <div class="form-title-bar">
            <i class="fas fa-poll form-icon"></i>
            <input id="formName" type="text" class="form-name-input" value="@Model.Title" placeholder="Новая форма" />
            <div class="header-menu-icons">
                <i class="fas fa-eye" title="Предпросмотр"></i>
                <i class="fas fa-undo" title="Отменить"></i>
                <i class="fas fa-redo" title="Повторить"></i>
                <i class="fas fa-link" title="Получить ссылку"></i>
                <i class="fas fa-user-plus" title="Поделиться"></i>
            </div>
            <button class="publish-btn">Опубликовать</button>
            <img src="/images/avatar.png" class="header-avatar" alt="Avatar" />
        </div>

        <div class="form-tabs-nav">
            <a href="#" class="form-tab active" data-tab="questions">Вопросы</a>
            <a href="#" class="form-tab" data-tab="responses">Ответы</a>
            <a href="#" class="form-tab" data-tab="settings">Настройки</a>
        </div>
    </div>

    <div class="form-builder-main-area">
        <div class="form-info-card">
            <input id="mainTitle" type="text" class="form-main-title" value="@Model.Title" placeholder="Новая форма" />
            <textarea id="mainDescription" class="form-description-area" placeholder="Описание">@Model.Description</textarea>
        </div>

        <div class="form-content-wrapper">
            <div class="questions-list" id="questionsList">
                <div class="question-card active-question" data-index="0">
                    <div class="question-header-row">
                        <input type="text" class="question-title-input" placeholder="Вопрос без заголовка" />
                        <i class="fas fa-image question-image-icon" title="Добавить изображение" data-action="image"></i>

                        <select class="question-type-select">
                            <option>Один из списка</option>
                            <option>Несколько из списка</option>
                            <option>Текст (строка)</option>
                            <option>Текст (абзац)</option>
                        </select>
                    </div>

                    <div class="question-options">
                        <div class="option-row">
                            <input type="radio" disabled />
                            <input type="text" value="Вариант 1" class="option-input" />
                            <i class="fas fa-times delete-option-icon" title="Удалить вариант"></i>
                        </div>
                        <div class="option-row add-option" data-action="addOption">
                            <input type="radio" disabled />
                            <span class="add-option-text">Добавить вариант</span>
                            <span class="or-text">или</span>
                            <a href="#" class="add-other-option">добавить вариант "Другое"</a>
                        </div>
                    </div>

                    <div class="question-footer-row">
                        <div class="actions-left">
                            <i class="fas fa-copy" title="Дублировать" data-action="duplicate"></i>
                            <i class="fas fa-trash" title="Удалить" data-action="delete"></i>
                        </div>
                        <div class="actions-right">
                            <span>Обязательный вопрос</span>
                            <label class="switch">
                                <input type="checkbox" checked>
                                <span class="slider round"></span>
                            </label>
                            <i class="fas fa-ellipsis-v options-menu" title="Дополнительно"></i>
                        </div>
                    </div>
                </div>

            </div>

            <div class="floating-toolbar" id="floatingToolbar">
                <i class="fas fa-plus" title="Добавить вопрос" data-action="addQuestion"></i>
                <i class="fas fa-file-signature" title="Импортировать вопросы" data-action="import"></i>
                <i class="fas fa-font" title="Добавить текст" data-action="addText"></i>
                <i class="fas fa-image" title="Добавить изображение" data-action="addImage"></i>
                <i class="fas fa-video" title="Добавить видео" data-action="addVideo"></i>
                <i class="fas fa-equals" title="Добавить раздел" data-action="addSection"></i>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Tabs switching with animation
            const tabs = document.querySelectorAll('.form-tab');
            tabs.forEach(tab => tab.addEventListener('click', (e) => {
                e.preventDefault();
                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                // Could show/hide panes; for now just animates the active tab underline
            }));

            // Floating toolbar actions
            const toolbar = document.getElementById('floatingToolbar');
            const questionsList = document.getElementById('questionsList');

            toolbar.addEventListener('click', function (e) {
                const action = e.target.closest('[data-action]')?.dataset.action;
                if (!action) return;

                switch (action) {
                    case 'addQuestion':
                        addQuestion();
                        break;
                    case 'addText':
                        addTextBlock();
                        break;
                    case 'addImage':
                        addImageBlock();
                        break;
                    case 'addVideo':
                        addVideoBlock();
                        break;
                    case 'addSection':
                        addSection();
                        break;
                    case 'import':
                        alert('Импорт вопросов пока не реализован.');
                        break;
                }
            });

            // Delegate question list actions
            questionsList.addEventListener('click', function (e) {
                const actionEl = e.target.closest('[data-action]');
                if (actionEl) {
                    const action = actionEl.dataset.action;
                    const card = e.target.closest('.question-card');
                    if (action === 'addOption') {
                        addOption(card);
                    }
                    return;
                }

                if (e.target.classList.contains('delete-option-icon')) {
                    e.target.closest('.option-row').remove();
                }

                if (e.target.dataset.action === 'duplicate') {
                    const card = e.target.closest('.question-card');
                    duplicateQuestion(card);
                }

                if (e.target.dataset.action === 'delete') {
                    const card = e.target.closest('.question-card');
                    if (card) card.remove();
                }
            });

            function addQuestion() {
                const index = questionsList.children.length;
                const el = document.createElement('div');
                el.className = 'question-card';
                el.dataset.index = index;
                el.innerHTML = `
                    <div class="question-header-row">
                        <input type="text" class="question-title-input" placeholder="Вопрос без заголовка" />
                        <i class="fas fa-image question-image-icon" title="Добавить изображение" data-action="image"></i>

                        <select class="question-type-select">
                            <option>Один из списка</option>
                            <option>Несколько из списка</option>
                            <option>Текст (строка)</option>
                            <option>Текст (абзац)</option>
                        </select>
                    </div>
                    <div class="question-options">
                        <div class="option-row">
                            <input type="radio" disabled />
                            <input type="text" value="Вариант 1" class="option-input" />
                            <i class="fas fa-times delete-option-icon" title="Удалить вариант"></i>
                        </div>
                        <div class="option-row add-option" data-action="addOption">
                            <input type="radio" disabled />
                            <span class="add-option-text">Добавить вариант</span>
                            <span class="or-text">или</span>
                            <a href="#" class="add-other-option">добавить вариант "Другое"</a>
                        </div>
                    </div>
                    <div class="question-footer-row">
                        <div class="actions-left">
                            <i class="fas fa-copy" title="Дублировать" data-action="duplicate"></i>
                            <i class="fas fa-trash" title="Удалить" data-action="delete"></i>
                        </div>
                        <div class="actions-right">
                            <span>Обязательный вопрос</span>
                            <label class="switch">
                                <input type="checkbox">
                                <span class="slider round"></span>
                            </label>
                            <i class="fas fa-ellipsis-v options-menu" title="Дополнительно"></i>
                        </div>
                    </div>
                `;

                questionsList.appendChild(el);
                // Smooth reveal
                requestAnimationFrame(() => el.classList.add('active-question'));
            }

            function addOption(card) {
                if (!card) return;
                const wrapper = card.querySelector('.question-options');
                const div = document.createElement('div');
                div.className = 'option-row';
                div.innerHTML = '<input type="radio" disabled /><input type="text" class="option-input" value="Новый вариант" /><i class="fas fa-times delete-option-icon" title="Удалить вариант"></i>';
                wrapper.insertBefore(div, wrapper.querySelector('.add-option'));
                // focus
                div.querySelector('.option-input').focus();
            }

            function duplicateQuestion(card) {
                if (!card) return;
                const clone = card.cloneNode(true);
                clone.dataset.index = questionsList.children.length;
                questionsList.appendChild(clone);
                requestAnimationFrame(() => clone.classList.add('active-question'));
            }

            function addTextBlock() {
                const el = document.createElement('div');
                el.className = 'question-card';
                el.innerHTML = '<textarea class="option-input" placeholder="Текстовый блок"></textarea>';
                questionsList.appendChild(el);
            }

            function addImageBlock() {
                const el = document.createElement('div');
                el.className = 'question-card';
                el.innerHTML = '<div style="padding:8px">Добавлено поле для изображения (здесь можно прикрепить файл при следующей итерации)</div>';
                questionsList.appendChild(el);
            }

            function addVideoBlock() {
                const el = document.createElement('div');
                el.className = 'question-card';
                el.innerHTML = '<div style="padding:8px">Добавлено поле для видео (вставьте ссылку на видео)</div>';
                questionsList.appendChild(el);
            }

            function addSection() {
                const el = document.createElement('div');
                el.className = 'question-card';
                el.innerHTML = '<div style="padding:8px; font-weight:600">Раздел</div>';
                questionsList.appendChild(el);
            }

        })();
    </script>
}